{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug"],
            "dependsOn": "Configure",
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug", "--clean-first"],
            "dependsOn": "Configure",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "-C", "Debug", "--output-on-failure"],
            "problemMatcher": []
        },
        {
            "label": "Build + Tests",
            "dependsOrder": "sequence",
            "dependsOn": ["Build", "Tests"],
            "problemMatcher": []
        }
    ]
}