{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-msvc-debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-msvc-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CTest: Debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--preset",
        "windows-msvc-debug"
      ],
      "dependsOn": "CMake: build Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run agent",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\msvc-debug\\bin\\Debug\\system_monitoring_agent.exe",
      "dependsOn": "CMake: build Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
